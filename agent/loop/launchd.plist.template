<?xml version="1.0" encoding="UTF-8"?>
<!-- 自律ループの定時の起動（毎時23分）。雛形なので、そのままでは使わない。
     agent/loop/install.py が __PYTHON__・__HOME__・__PATH__ を埋めて ~/Library/LaunchAgents/ に書く。
     書いただけでは動かない。読み込むのは持ち主が手で行う（agent/loop/README.md）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.homelab-data-platform.loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__HOME__/homelab-loop/bin/agent/loop/run.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>23</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__HOME__/homelab-loop</string>
  <key>StandardOutPath</key>
  <string>__HOME__/homelab-loop/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/homelab-loop/logs/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
