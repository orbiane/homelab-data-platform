{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__sl__list_metrics",
      "mcp__sl__get_dimensions",
      "mcp__sl__query_metrics",
      "mcp__sl__run_sql",
      "Bash(dbt parse *)",
      "Bash(dbt ls *)",
      "Bash(dbt compile *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(uv run *)",
      "Bash(uv tool *)",
      "Bash(docker compose down *)",
      "Edit(**/_metrics.yml)",
      "Edit(**/_semantic_models.yml)",
      "Bash(git config core.hooksPath *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git filter-repo *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(mf *)",
      "Bash(duckdb *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/adr007_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
