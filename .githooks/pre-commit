#!/bin/sh
# 今回のコミットで足す行（git diff --cached の + の行）だけを調べる。
# 今あるファイル全体は調べない。

. "$(dirname "$0")/scan.sh"

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

git diff --cached --no-color --no-ext-diff --text -U0 >"$tmp/diff" || exit 1

# + の行を、本文（txt）と場所（loc。ファイル名:行番号）に分けて書き出す。
# ファイルの見出しの +++ は、@@ の前にあるものだけを見出しとして扱う。
awk -v txtf="$tmp/txt" -v locf="$tmp/loc" '
  /^diff --git / { inhunk = 0; next }
  /^\+\+\+ / && !inhunk { f = substr($0, 5); sub(/^b\//, "", f); next }
  /^@@ / { inhunk = 1; n = $3; sub(/^\+/, "", n); sub(/,.*/, "", n); ln = n + 0; next }
  inhunk && /^\+/ { print substr($0, 2) > txtf; print f ":" ln > locf; ln++ }
  END { printf "" > txtf; printf "" > locf }
' "$tmp/diff" || exit 1

ng=0
scan_lines pre-commit "$tmp/txt" "$tmp/loc" || ng=1

# ADR-007 の R6。個人情報の検査とは別に、必ず走らせる
. "$(dirname "$0")/definition_guard.sh"
mkdir "$tmp/def" || exit 1
definition_guard "$tmp/def" || ng=1

exit $ng
